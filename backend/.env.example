# Copy this file to .env and fill in real values.
# Never commit the real .env file — it is git-ignored.

# Server
PORT=4000
NODE_ENV=development

# MongoDB connection string (required once models are introduced)
# e.g. mongodb://127.0.0.1:27017/lifeos  (local)  or  a MongoDB Atlas URI
MONGODB_URI=

# Auth — required in the authentication phase (no fallback is used)
JWT_SECRET=

# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:5173